# URL và anon (publishable) key của dự án Supabase.
# Local: chạy `npm run db:start` rồi lấy từ `supabase status` (API URL, anon key).
# Không bao giờ đặt service_role key ở đây — key này chỉ dùng trong Edge Function.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
# Tùy chọn: URL gốc của Edge Functions. Bỏ trống để dùng ${VITE_SUPABASE_URL}/functions/v1.
# Local khi chạy `npm run functions:serve`: http://127.0.0.1:54329
VITE_FUNCTIONS_URL=

# Chỉ dùng cho `npm run functions:serve` khi kiểm TURN local. Không đặt hai secret này ở Vercel
# hoặc biến VITE_*: production lưu bằng `supabase secrets set` cho Edge Function `voice-ice`.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
